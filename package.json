{
  "name": "dsh-clock",
  "version": "0.3.1",
  "description": "给 DSH 加一只时钟：记录本轮对话从 turn/start 起已经运行多久（clock_elapsed 工具），按 /set-time 的三段式排程在本步之前注入收尾提示词，并支持提醒卡片与设置页自定义模板。",
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "clock",
    "timer",
    "elapsed"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\" \"tests/*.mjs\""
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.2 <5"
  },
  "dependencies": {
    "zod": "^3.25.76"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.0-rc.1 <1.0.0"
  }
}
